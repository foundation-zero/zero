{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgeCrate",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgePypi",
    "workarounds:all"
  ],
  "packageRules": [
    {
      "description": "One PR for all non-major Rust crate updates, so they stop conflicting on the shared Cargo.lock files",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major Rust crates"
    },
    {
      "description": "Read the Python version from uv builder tags like python3.13-trixie-slim, so the builder moves with the runtime image",
      "matchDepNames": ["ghcr.io/astral-sh/uv"],
      "versioning": "regex:^python(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.+)$"
    },
    {
      "description": "Move the Python version in Dockerfiles, workflows and requires-python together",
      "matchDepNames": ["python", "ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "Python"
    }
  ]
}
