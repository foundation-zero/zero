{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgeCrate",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgePypi",
    "workarounds:all"
  ],
  "timezone": "Europe/Amsterdam",
  "hostRules": [
    {
      "matchHost": "europe-west1-docker.pkg.dev",
      "username": "_json_key_base64",
      "password": "{{ secrets.GAR_JSON_KEY_BASE64 }}"
    }
  ],
  "packageRules": [
    {
      "description": "docker-compose.yml images follow what runs on board (edge-flux, or the on-board Home Assistant), so we bump them by hand instead of tracking upstream",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker-compose.yml"],
      "enabled": false
    },
    {
      "description": "One PR for all non-major Rust crate updates, so they stop conflicting on the shared Cargo.lock files",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major Rust crates"
    },
    {
      "description": "Read the Python version from uv builder tags like python3.13-trixie-slim, so the builder moves with the runtime image",
      "matchDepNames": ["ghcr.io/astral-sh/uv"],
      "versioning": "regex:^python(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.+)$"
    },
    {
      "description": "Move the Python version in Dockerfiles, workflows and requires-python together",
      "matchDepNames": ["python", "ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "Python"
    },
    {
      "description": "zero-ui updates arrive every other Thursday from 2026-11-26, one upgrade task per sprint. Cron cannot count weeks, so the dates are listed; extend them before November 2027",
      "matchFileNames": ["zero-ui/**"],
      "schedule": [
        "* * 26 11 *",
        "* * 10,24 12 *",
        "* * 7,21 1 *",
        "* * 4,18 2 *",
        "* * 4,18 3 *",
        "* * 1,15,29 4 *",
        "* * 13,27 5 *",
        "* * 10,24 6 *",
        "* * 8,22 7 *",
        "* * 5,19 8 *",
        "* * 2,16,30 9 *",
        "* * 14,28 10 *"
      ]
    },
    {
      "description": "One PR for all non-major zero-ui updates; majors keep a PR each",
      "matchFileNames": ["zero-ui/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "non-major zero-ui dependencies"
    }
  ]
}
