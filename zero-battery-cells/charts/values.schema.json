{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": [
    "nvlFile",
    "mqtt",
    "udp"
  ],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository."
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string",
          "description": "Overrides the image tag whose default is the chart appVersion."
        }
      }
    },
    "nvlFile": {
      "type": "string",
      "description": "Path to the template NetVar declaration inside the container."
    },
    "ownListIds": {
      "type": "array",
      "description": "List ids this release decodes; empty means every known list id.",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "uniqueItems": true
    },
    "logLevel": {
      "type": "string",
      "description": "Value for the RUST_LOG environment variable (for example: info, debug, trace).",
      "default": "info"
    },
    "mqtt": {
      "type": "object",
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "description": "MQTT broker hostname."
        },
        "port": {
          "type": "integer",
          "description": "MQTT broker port.",
          "minimum": 1,
          "maximum": 65535
        },
        "prefix": {
          "type": "string",
          "description": "MQTT topic prefix; topics are {prefix}/{pack}/{string}/{module}."
        },
        "existingSecret": {
          "type": "string",
          "description": "Existing secret name containing MQTT username (key `username`) and password."
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "description": "Key in existingSecret that stores the MQTT password."
        }
      }
    },
    "udp": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "annotations": {
          "type": "object",
          "description": "Annotations added to the UDP service.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "description": "Labels added to the UDP service.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "externalIPs": {
          "type": "array",
          "description": "External IPs assigned to the UDP service.",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer",
          "description": "UDP port the PLCs send their NetVar lists to; exposed by the service and container.",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Container resource requests and limits."
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Secrets for pulling images from a private registry.",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name."
    }
  }
}
