{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["mqtt", "modbus"],
  "properties": {
    "mqtt": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "description": "MQTT broker hostname."
        },
        "port": {
          "type": "integer",
          "description": "MQTT broker port.",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "description": "MQTT username."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Kubernetes Secret containing the MQTT password."
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "description": "Key in the existing Secret that holds the MQTT password."
        }
      }
    },
    "modbus": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "description": "Default Modbus TCP port for gateways without a per-panel override.",
          "minimum": 1,
          "maximum": 65535
        },
        "probe_interval": {
          "type": "integer",
          "description": "Seconds between Modbus reads.",
          "minimum": 1
        },
        "panels": {
          "type": "object",
          "description": "Gateway per panel. Keys are sanitized panel names (panel 10P0.1 → key 10p0_1) rendered as MODBUS_PANELS__host_<key> / MODBUS_PANELS__port_<key> environment variables.",
          "additionalProperties": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "Gateway hostname or IP address."
              },
              "port": {
                "type": "integer",
                "description": "Gateway Modbus TCP port; defaults to the global modbus.port.",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "stub": {
          "type": "object",
          "description": "Dummy-data mode: deploy a stub Modbus workload and point every panel at it (for envs without hardware).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Deploy the stub workload/Service and route the run deployment's panels to it."
            },
            "basePort": {
              "type": "integer",
              "description": "First Modbus port for the stub; panels are spread over consecutive ports from here. Must be unprivileged (>= 1024) since the stub runs as non-root.",
              "minimum": 1024,
              "maximum": 65535
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository."
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy.",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string",
          "description": "Overrides the image tag whose default is the chart appVersion."
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Container resource requests and limits."
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Secrets for pulling images from a private registry.",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name."
    }
  }
}
