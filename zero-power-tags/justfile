set dotenv-load := true

default: check

check: lint type_check test

check_static: lint_no_fix format type_check

lint:
    uv run ruff check

lint_no_fix:
    uv run ruff check --no-fix

type_check:
    uv run pyright

test *args:
    uv run pytest --cov --cov-report=term-missing:skip-covered {{ args }}

format:
    uv run ruff format --check

refresh_io:
    uv run python ./scripts/excel_to_json.py --patches patches.json

generate-asyncapi file="../specs/power-tags.json":
    uv run python -m zero_power_tags generate-asyncapi {{ file }}
