      "panel-7": {
        "kind": "Panel",
        "spec": {
          "title": "Temperature & humidity",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "info8fcc-greptimedb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "2.1.4",
                        "queryType": "table",
                        "rawSql": "SELECT DISTINCT ON (room)\n  room        AS room,\n  power         AS on_off,\n  heater_power  AS heater_on_off,\n  fan_speed   AS fan_speed,\n  setpoint_room_temperature     AS temperature_setpoint,\n  air_temperature_in      AS temperature,\n  humidity,\n  status      AS status,\n  to_unixtime(now()) - to_unixtime(timestamp) AS \"Updated\"\nFROM public.termodinamica__ac\nWHERE timestamp > now() - INTERVAL '$live_window' AND room IS NOT NULL\nORDER BY room, timestamp DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "includeByName": {},
                      "indexByName": {},
                      "renameByName": {
                        "fan_speed": "Fan speed",
                        "heater_on_off": "Heater On/Off",
                        "humidity": "Humidity",
                        "on_off": "On/Off",
                        "room": "Room",
                        "source_type": "Source",
                        "status": "Status",
                        "temperature": "Temperature",
                        "temperature_setpoint": "Temperature setpoint",
                        "topic": "Room"
