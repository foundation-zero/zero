                        "source_type": "Source",
                        "status": "Status",
                        "temperature": "Temperature",
                        "temperature_setpoint": "Temperature setpoint",
                        "topic": "",
                        "total_watt": "",
                        "watt_compressor_1": "Compressor 1",
                        "watt_compressor_2": "Compressor 2",
