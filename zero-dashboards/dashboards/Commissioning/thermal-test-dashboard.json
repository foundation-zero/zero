            "version": "12.3.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": []
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "watt",
                  "decimals": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "center",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  },
                  "noValue": "No data in the last 5 minutes"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "–"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Updated"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "suffix: sec ago"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": null,
                              "color": "text"
                            },
                            {
                              "value": 60,
                              "color": "orange"
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      }
                    ]
                  }
                ]
              }
            }
          },
          "description": "The latest value within the live window ($live_window), independent of the selected time range; empty when nothing was published in that window. Updated: seconds since the latest message.",
