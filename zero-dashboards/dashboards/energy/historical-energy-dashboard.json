          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n\tdate_trunc('day', hour) AS day,\r\n\t-- Producers\r\n\tSUM(CASE WHEN group_name = 'Hydrogeneration' THEN energy_wh ELSE 0 END) AS hydrogeneration,\r\n\tSUM(CASE WHEN group_name = 'Solar' THEN energy_wh ELSE 0 END) AS solar,\r\n\tSUM(CASE WHEN group_name = 'Shore' THEN energy_wh ELSE 0 END) AS shore,\r\n\t-- Consumers\r\n\tSUM(CASE WHEN group_name = 'Domestic' THEN -energy_wh ELSE 0 END) AS domestic,\r\n\tSUM(CASE WHEN group_name = 'HVAC' THEN -energy_wh ELSE 0 END) AS hvac,\r\n\tSUM(CASE WHEN group_name = 'Technical' THEN -energy_wh ELSE 0 END) AS technical,\r\n\tSUM(CASE WHEN group_name = 'Propulsion' THEN -energy_wh ELSE 0 END) AS propulsion\r\nFROM energy.electrical_hourly\r\nGROUP BY day",
          "refId": "A",
          "sql": {
            "columns": [
