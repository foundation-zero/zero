      "targets": [
        {
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "",
              "limit": 1000,
              "meta": {},
              "mode": "list",
