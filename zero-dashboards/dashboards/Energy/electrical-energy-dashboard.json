          "pluginVersion": "3.0.2",
          "queryType": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  time,\r\n\t-- Producers\r\n  SUM(CASE WHEN group_name = 'Solar' THEN energy ELSE 0 END) AS solar,\r\n  SUM(CASE WHEN group_name = 'Shore' THEN energy ELSE 0 END) AS shore,\r\n  SUM(CASE WHEN group_name = 'Hydrogeneration' THEN energy ELSE 0 END) AS hydrogeneration,\r\n\t-- Consumers\r\n  SUM(CASE WHEN group_name = 'Domestic' THEN energy ELSE 0 END) AS domestic,\r\n  SUM(CASE WHEN group_name = 'Technical' THEN energy ELSE 0 END) AS technical,\r\n  SUM(CASE WHEN group_name = 'HVAC' THEN energy ELSE 0 END) AS hvac,\r\n  SUM(CASE WHEN group_name = 'Propulsion' THEN energy ELSE 0 END) AS propulsion\r\nFROM (\r\n  SELECT\r\n\t\tgroup_name,\r\n\t\thour AS time,\r\n\t\tCASE\r\n\t\t  -- Make the consumer values negative to place the bars under the X-axis\r\n\t\t\tWHEN group_name IN ('Domestic', 'Technical', 'HVAC', 'Propulsion') THEN energy * -1\r\n\t\t\t-- The consumer values are placed above th X-axis\r\n\t\t\tELSE energy\r\n\t\tEND AS energy\r\n\tFROM (\r\n    SELECT\r\n      date_trunc('hour', time) AS hour,\r\n  \t\tmain_group AS group_name,\r\n  \t\tsub_group AS sub_group_name,\r\n  \t\tSUM(power) / 60 AS energy\r\n  \tFROM views.gld_electrical_power_consumption_per_minute\r\n  \tGROUP BY hour, main_group, sub_group\r\n  )\r\n)\r\nGROUP BY time\r\nORDER BY time",
          "refId": "Electrical hourly",
          "sql": {
