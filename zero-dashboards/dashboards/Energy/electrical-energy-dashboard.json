          "rawSql": "SELECT time, -- Producers\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'Solar' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS solar,\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'Shore' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS shore,\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'Hydrogeneration' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS hydrogeneration, -- Consumers\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'Domestic' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS domestic,\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'Technical' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS technical,\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'HVAC' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS hvac,\r\nSUM(CASE\r\n\t\t\t\tWHEN group_name = 'Propulsion' THEN energy_wh\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS propulsion\r\nFROM\r\n\t(SELECT group_name, -- To display producers and consumers side-by-side, I altered the time value.\r\nCASE\r\n\t\tWHEN group_name IN ('Solar',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'Shore',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'Hydrogeneration') THEN hour - INTERVAL '5 minutes'\r\n\t\tELSE hour + INTERVAL '5 minutes'\r\nEND AS time, -- For testing purposes, I multiplied the values of the producers by 50.\r\nCASE\r\n\t\tWHEN group_name IN ('Solar',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'Shore',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'Hydrogeneration') THEN energy_wh * 40\r\n\t\tELSE energy_wh\r\nEND AS energy_wh\r\n\tFROM energy.electrical_hourly\r\n\tWHERE group_name IS NOT NULL)\r\nGROUP BY time\r\nORDER BY time",
