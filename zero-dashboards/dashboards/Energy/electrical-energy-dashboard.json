          "pluginVersion": "3.0.2",
          "queryType": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  MAX(time) AS time,\r\n  main_group,\r\n  AVG(power_value) AS power_value\r\nFROM (\r\n  SELECT\r\n    time,\r\n    main_group,\r\n    SUM(power) AS power_value\r\n  FROM views.gld_electrical_power_consumption_per_minute\r\n  WHERE time >= date_sub($__to::TIMESTAMP, '5 minutes') AND time < $__to::TIMESTAMP\r\n  GROUP BY\r\n    time,\r\n    main_group\r\n)\r\nGROUP BY main_group",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
