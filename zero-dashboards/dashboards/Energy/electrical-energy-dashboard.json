          "queryType": "table",
          "rawQuery": true,
          "rawSql": "SELECT group_name,\r\n\t\t\tsub_group_name,\r\n\t\t\tSUM(avg_energy) AS energy,\r\n\t\t\tSUM(SUM(avg_energy)) OVER (PARTITION BY group_name) AS group_energy\r\nFROM\r\n\t(SELECT group_name,\r\n\t\t\t\t\tsub_group_name,\r\n\t\t\t\t\tAVG(energy_wh) AS avg_energy\r\n\tFROM energy.electrical_hourly\r\n\tWHERE group_name IN ('Domestic',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'HVAC',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'Technical',\r\n\t\t\t\t\t\t\t\t\t\t\t\t'Propulsion')\r\n\t\tAND $__timeFilter(hour)\r\n\tGROUP BY topic,\r\n\t\t\t\t\t\tgroup_name,\r\n\t\t\t\t\t\tsub_group_name)\r\nGROUP BY group_name,\r\n\t\t\t\tsub_group_name",
          "refId": "A",
