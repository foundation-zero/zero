          "pluginVersion": "2.1.4",
          "queryType": "table",
          "rawQuery": true,
          "rawSql": "SELECT -- Producers\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Solar' THEN power_value\r\n\t\tEND) AS solar,\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Shore' THEN power_value\r\n\t\tEND) AS shore,\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Hydrogeneration' THEN power_value\r\n\t\tEND) AS hydro, -- Consumers\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Domestic' THEN power_value\r\n\t\tEND) AS domestic,\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Technical' THEN power_value\r\n\t\tEND) AS technical,\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'HVAC' THEN power_value\r\n\t\tEND) AS hvac,\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Propulsion' THEN power_value\r\n\t\tEND) AS propulsion, -- Batteries\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Charging'\r\n\t\t\t\t\t\t\tAND power_value >= 0 THEN power_value\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS charging,\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'Charging'\r\n\t\t\t\t\t\t\tAND power_value < 0 THEN -power_value\r\n\t\t\t\tELSE 0\r\n\t\tEND) AS discharging, -- For testing the value is artificially increased\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'State of charge' THEN power_value\r\n\t\tEND) * 100000 + 130000000 AS soc, -- For testing an artificial soc% is created\r\nMAX(CASE\r\n\t\t\t\tWHEN group_name = 'State of charge' THEN power_value\r\n\t\tEND) + 55 AS soc_perc\r\nFROM\r\n\t(SELECT time,\r\n\t\t\t\t\tgroup_name,\r\n\t\t\t\t\tgroup_power AS power_value\r\n\tFROM energy.electrical_flow\r\n\tUNION ALL SELECT MAX(time) AS time,\r\n\t\t\t\t\t\t\t\t\t\tgroup_name,\r\n\t\t\t\t\t\t\t\t\t\tSUM(stored_energy) AS power_value\r\n\tFROM energy.electrical_soc\r\n\tGROUP BY group_name)",
          "refId": "electrical_flow",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
