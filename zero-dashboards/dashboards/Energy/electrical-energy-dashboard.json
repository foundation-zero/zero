          "pluginVersion": "3.0.2",
          "queryType": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n\tmain_group AS group_name,\r\n\tsub_group AS sub_group_name,\r\n\tSUM(energy) AS energy,\r\n  SUM(SUM(energy)) OVER (PARTITION BY main_group) AS group_energy\r\nFROM (\r\n\tSELECT\r\n    date_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tsub_group,\r\n\t\tSUM(power) / 60 AS energy\r\n\tFROM views.gld_electrical_power_consumption_per_minute\r\n\tWHERE main_group IN ('Domestic', 'HVAC', 'Technical', 'Propulsion')\r\n\tAND $__timeFilter(time)\r\n\tGROUP BY hour, main_group, sub_group\r\n)\r\nGROUP BY main_group, sub_group",
          "refId": "A",
