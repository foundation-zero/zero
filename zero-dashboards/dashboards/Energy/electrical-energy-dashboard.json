                        "queryType": "table",
                        "rawQuery": true,
                        "rawSql": "WITH consumption_data AS (\r\n\tSELECT\r\n    date_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tpower\r\n\tFROM views.gld_power_tags_power_per_minute_per_main_group\r\n\tWHERE $__timeFilter(time)\r\n\t\r\n\tUNION ALL \r\n\t\r\n\tSELECT \r\n\t\tdate_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tpower\r\n\tFROM views.gld_24vdc_power_per_minute_per_main_group\r\n\tWHERE $__timeFilter(time)\r\n\t\r\n\tUNION ALL \r\n\t\r\n\tSELECT \r\n\t\tdate_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tpower\r\n\tFROM views.gld_aradex_power_per_minute_per_main_group\r\n\tWHERE $__timeFilter(time)\r\n\t\r\n\tUNION ALL \r\n\t\r\n\tSELECT \r\n\t\tdate_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tpower\r\n\tFROM views.gld_solar_power_per_minute_per_main_group\r\n\tWHERE $__timeFilter(time)\r\n\t\r\n\tUNION ALL \r\n\t\r\n\tSELECT \r\n\t\tdate_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tpower\r\n\tFROM views.gld_shore_power_per_minute_per_main_group\r\n\tWHERE $__timeFilter(time)\r\n)\r\n\r\nSELECT\r\n  hour                                                                     AS time,\r\n\t-- Producers\r\n  SUM(CASE WHEN main_group = 'Solar' THEN power ELSE 0 END) / 60           AS solar,\r\n  SUM(CASE WHEN main_group = 'Shore' THEN power ELSE 0 END) / 60           AS shore,\r\n  SUM(CASE WHEN main_group = 'Hydrogeneration' THEN power ELSE 0 END) / 60 AS hydrogeneration,\r\n\t-- Consumers\r\n  SUM(CASE WHEN main_group = 'Domestic' THEN -power ELSE 0 END) / 60       AS domestic,\r\n  SUM(CASE WHEN main_group = 'Technical' THEN -power ELSE 0 END) / 60      AS technical,\r\n  SUM(CASE WHEN main_group = 'HVAC' THEN -power ELSE 0 END) / 60           AS hvac,\r\n  SUM(CASE WHEN main_group = 'Propulsion' THEN -power ELSE 0 END) / 60     AS propulsion\r\nFROM consumption_data\r\nGROUP BY hour\r\nORDER BY hour",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
