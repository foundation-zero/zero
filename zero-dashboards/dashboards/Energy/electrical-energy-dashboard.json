      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "info8fcc-greptimedb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "dev",
                        "editorMode": "code",
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "meta": {},
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "3.0.2",
                        "queryType": "table",
                        "rawQuery": true,
                        "rawSql": "WITH consumption_data AS (\r\n\tSELECT\r\n    date_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tsub_group,\r\n\t\tpower\r\n\tFROM views.gld_power_tags_power_per_minute_per_sub_group\r\n\tWHERE $__timeFilter(time)\r\n\t\r\n\tUNION ALL \r\n\t\r\n\tSELECT \r\n\t\tdate_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tsub_group,\r\n\t\tpower\r\n\tFROM views.gld_24vdc_power_per_minute_per_sub_group\r\n\tWHERE $__timeFilter(time)\r\n\t\r\n\tUNION ALL \r\n\t\r\n\tSELECT \r\n\t\tdate_trunc('hour', time) AS hour,\r\n\t\tmain_group,\r\n\t\tNULL AS sub_group,\r\n\t\tpower\r\n\tFROM views.gld_aradex_power_per_minute_per_main_group\r\n\tWHERE $__timeFilter(time)\r\n)\r\n\r\nSELECT\r\n\tmain_group                                          AS group_name,\r\n\tCOALESCE(sub_group, main_group) \t\t\t\t\t\t    \t\tAS sub_group_name,\r\n\tSUM(power) / 60                                    AS energy,\r\n  SUM(SUM(power) / 60) OVER (PARTITION BY main_group) AS group_energy\r\nFROM consumption_data\r\nWHERE main_group in ('Domestic', 'HVAC', 'Technical', 'Propulsion')\r\nGROUP BY main_group, sub_group",
                        "sql": {
                          "columns": [
