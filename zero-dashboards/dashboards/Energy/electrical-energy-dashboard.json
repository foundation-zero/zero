      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "info8fcc-greptimedb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "dev",
                        "editorMode": "code",
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "meta": {},
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "3.0.2",
                        "queryType": "table",
                        "rawQuery": true,
                        "rawSql": "WITH consumption_data AS (\r\n  SELECT time, main_group, power\r\n  FROM views.gld_power_tags_power_per_minute_per_main_group\r\n  WHERE time >= date_sub($__toTime, '5 minutes'::INTERVAL) AND time < $__toTime\r\n\r\n  UNION ALL\r\n     \r\n  SELECT time, main_group, power\r\n  FROM views.gld_24vdc_power_per_minute_per_main_group\r\n  WHERE time >= date_sub($__toTime, '5 minutes'::INTERVAL) AND time < $__toTime\r\n\r\n  UNION ALL\r\n     \r\n  SELECT time, main_group, power\r\n  FROM views.gld_aradex_power_per_minute_per_main_group\r\n  WHERE time >= date_sub($__toTime, '5 minutes'::INTERVAL) AND time < $__toTime\r\n\r\n  UNION ALL\r\n     \r\n  SELECT time, main_group, power\r\n  FROM views.gld_solar_power_per_minute_per_main_group\r\n  WHERE time >= date_sub($__toTime, '5 minutes'::INTERVAL) AND time < $__toTime\r\n\r\n  UNION ALL\r\n     \r\n  SELECT time, main_group, power\r\n  FROM views.gld_shore_power_per_minute_per_main_group\r\n  WHERE time >= date_sub($__toTime, '5 minutes'::INTERVAL) AND time < $__toTime\r\n)\r\n\r\nSELECT\r\n  MAX(time) AS time,\r\n\r\n\t-- Producers\r\n  MAX(CASE WHEN main_group = 'Solar' THEN power_value ELSE 0 END)                AS solar,\r\n  MAX(CASE WHEN main_group = 'Shore' THEN power_value ELSE 0 END)                AS shore_power,\r\n  MAX(CASE WHEN main_group = 'Hydrogeneration' THEN power_value ELSE 0 END)      AS hydro,\r\n  -- Consumers\r\n  MAX(CASE WHEN main_group = 'Domestic' THEN power_value ELSE 0 END)             AS domestic,\r\n  MAX(CASE WHEN main_group = 'HVAC' THEN power_value ELSE 0 END)                 AS hvac,\r\n  MAX(CASE WHEN main_group = 'Technical' THEN power_value ELSE 0 END)            AS technical,\r\n  MAX(CASE WHEN main_group = 'Propulsion' THEN power_value ELSE 0 END)           AS propulsion\r\nFROM (\r\n  SELECT\r\n    MAX(time) AS time,\r\n    main_group,\r\n    AVG(power_value) AS power_value\r\n  FROM (\r\n    SELECT time, main_group, SUM(power) AS power_value\r\n    FROM consumption_data\r\n    GROUP BY time, main_group\r\n  )\r\n  GROUP BY main_group\r\n)",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "info8fcc-greptimedb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "meta": {},
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "3.0.2",
                        "queryType": "table",
                        "rawSql": "SELECT\r\n  MAX(time)                                                                                                  AS time,\r\n  SUM(avg_energy_per_pack)                                                                                   AS energy,\r\n  (SUM(avg_energy_per_pack) / NULLIF(SUM(avg_energy_per_pack / NULLIF(avg_soc_per_pack, 0) * 100), 0)) * 100 AS soc,\r\n  SUM(avg_charging_power_per_pack)                                                                           AS charging_power,\r\n  SUM(avg_discharging_power_per_pack)                                                                        AS discharging_power\r\nFROM (\r\n  SELECT\r\n    MAX(time)                                                              AS time,\r\n    topic,\r\n    AVG(avg_energy)                                                        AS avg_energy_per_pack,\r\n    AVG(avg_soc)                                                           AS avg_soc_per_pack,\r\n    CASE WHEN MAX(is_charging) THEN AVG(ABS(avg_battery_power)) ELSE 0 END AS avg_charging_power_per_pack,\r\n    CASE WHEN MAX(is_discharging) THEN AVG(avg_battery_power) ELSE 0 END   AS avg_discharging_power_per_pack\r\n  FROM views.gld_batteries_per_minute\r\n  WHERE time >= date_sub($__toTime, '5 minutes'::INTERVAL) AND time < $__toTime\r\n  GROUP BY topic\r\n)"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
