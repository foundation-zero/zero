  "components": {
    "messages": {
      "power-tags.{panel}.{slug}:Message": {
        "title": "power-tags/{panel}/{slug}:Message",
        "correlationId": {
          "location": "$message.header#/correlation_id"
        },
        "payload": {
          "$ref": "#/components/schemas/PowerTag"
        }
      }
    },
    "schemas": {
      "PowerTag": {
        "description": "One PowerTag breaker's readings.\n\nThe annotated ``ModbusField(register=…)`` addresses are absolute: every\nbreaker exposes the same register block on its own Modbus slave id, so\nthis model is the single source of truth for the register map.",
        "properties": {
          "component": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Component"
          },
          "panel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Panel"
          },
          "consumer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Consumer"
          },
          "current_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current A",
            "x-unit": "A"
          },
          "current_b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current B",
            "x-unit": "A"
          },
          "current_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current C",
            "x-unit": "A"
          },
          "current_n": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current N",
            "x-unit": "A"
          },
          "voltage_an": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage An",
            "x-unit": "V"
          },
          "voltage_bn": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage Bn",
            "x-unit": "V"
          },
          "voltage_cn": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage Cn",
            "x-unit": "V"
          },
          "active_power_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Power A",
            "x-unit": "W"
          },
          "active_power_b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Power B",
            "x-unit": "W"
          },
          "active_power_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Power C",
            "x-unit": "W"
          },
          "active_power_total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Power Total",
            "x-unit": "W"
          },
          "power_factor_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Factor A"
          },
          "power_factor_b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Factor B"
          },
          "power_factor_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Factor C"
          },
          "power_factor_total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Power Factor Total"
          }
        },
        "required": [
          "current_a",
          "current_b",
          "current_c",
          "current_n",
          "voltage_an",
