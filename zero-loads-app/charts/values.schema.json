{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "mqtt": {
      "description": "MQTT configuration",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string"
        },
        "maxMessageAgeSeconds": {
          "description": "Values from a topic without a message for this long are reported as missing",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["host", "port", "existingSecret"],
      "type": "object"
    },
    "postgresql": {
      "description": "PostgreSQL configuration",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "user": {
          "type": "string"
        },
        "db": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string"
        }
      },
      "required": ["host", "port", "user", "db", "existingSecret"],
      "type": "object"
    },
    "api": {
      "description": "API configuration",
      "properties": {
        "env": {
          "type": "string",
          "enum": ["development", "production"]
        }
      },
      "required": ["env"],
      "type": "object"
    }
  },
  "required": ["mqtt", "postgresql", "api"],
  "title": "Values",
  "type": "object"
}
