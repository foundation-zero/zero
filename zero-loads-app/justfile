cov := "--cov --cov-report=term-missing:skip-covered"

export_seed:
    uv run loads export-seed

check_seed:
    uv run loads check-seed

export_cheat_sheet:
    uv run loads export-cheat-sheet

test:
    uv run pytest {{ cov }}

test_integration *args:
    uv run pytest {{ cov }} --run=integration {{ args }}

test_unit *args:
    uv run pytest {{ cov }} --run=unit {{ args }}

run_demo:
    uv run loads api &
    uv run loads sail-system-sensors-stub &
    uv run loads fiber-optic-sensors-stub &
    uv run loads at-sensors-stub &
    wait

run:
    uv run loads api 

lint:
    uv run ruff check --fix

lint_no_fix:
    uv run ruff check --no-fix

type_check:
    uv run pyright

format:
    uv run ruff format --check

check: lint type_check test
