export_seed:
    uv run loads export-seed

check_seed:
    uv run loads check-seed

test *args:
    uv run pytest {{ args }}

test_integration *args:
    uv run pytest --run=integration {{ args }}

test_unit *args:
    uv run pytest --run=unit {{ args }}

run_demo:
    uv run loads api &
    uv run loads sail-system-sensors-stub &
    uv run loads fiber-optic-sensors-stub &
    uv run loads at-sensors-stub &
    wait

run:
    uv run loads api 

lint:
    uv run ruff check --fix

lint_no_fix:
    uv run ruff check --no-fix

type_check:
    uv run pyright

format:
    uv run ruff format --check

check: lint type_check test
