set dotenv-load := true

cov := "--cov --cov-report=term-missing:skip-covered"

default: check

check: lint type_check test

check_static: lint_no_fix format type_check

lint:
    uv run ruff check

lint_no_fix:
    uv run ruff check --no-fix src tests

type_check:
    uv run pyright

test *args:
    uv run pytest {{ cov }} {{ args }}

test_integration *args:
    uv run pytest {{ cov }} --run=integration {{ args }}

test_unit *args:
    uv run pytest {{ cov }} --run=unit {{ args }}

format:
    uv run ruff format --check src tests
