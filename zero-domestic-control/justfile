set dotenv-load := true

default: check

check: lint type_check test

lint:
    uv run ruff check

lint_no_fix:
    uv run ruff check --no-fix src tests

type_check:
    uv run pyright

test *args:
    uv run pytest {{ args }}

test_integration *args:
    uv run pytest --run=integration {{ args }}

test_unit *args:
    uv run pytest --run=unit {{ args }}

format:
    uv run ruff format --check src tests
