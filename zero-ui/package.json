{
  "name": "zero-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest --exclude **/api.integration.spec.ts --coverage --coverage.reportsDirectory=../coverage/unit",
    "test:api": "vitest api.integration.spec.ts --coverage --coverage.reportsDirectory=../coverage/api",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.ts dotenv_config_path=.env.local",
    "codegen:schema": "graphql-codegen --require dotenv/config --config codegen.ts --schema-only dotenv_config_path=.env.local",
    "extract-schema-values": "tsx scripts/extract-schema-values.ts",
    "generate-graphql-queries": "tsx scripts/generate-graphql-queries.ts",
    "generate-tooltips": "tsx scripts/generate-tooltips.ts",
    "extract-all-schemas": "tsx scripts/extract-all-schemas.ts",
    "convert-direction-arrows": "tsx scripts/convert-direction-arrows.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@foundation-zero/graphql-subscriptions-mock": "^1.0.2",
    "@readme/openapi-parser": "^10.0.0",
    "@remixicon/vue": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.3.1",
    "@urql/exchange-auth": "^3.0.0",
    "@urql/vue": "^2.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/rxjs": "^15.0.0",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.4.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "mqtt": "^5.16.1",
    "oas": "^39.0.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-number-animation": "^2.0.2",
    "vue-router": "^5.4.0",
    "wonka": "^6.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-typed-document-node/core": "3.2.0",
    "@msw/playwright": "0.7.0",
    "@pinia/testing": "2.0.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.1",
    "class-variance-authority": "0.7.1",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-eslint": "17.1.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sass": "1.106.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
