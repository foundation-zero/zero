default: run

run:
    pnpm dev

check: lint type_check test

lint:
    pnpm lint

type_check:
    pnpm typecheck

test:
    pnpm test:unit

generate_tooltips:
    pnpm generate-tooltips

# Regenerate the AsyncAPI Specs, then thrapp's definitions and MQTT GraphQL queries from them
generate_mqtt_graphql_queries:
    pnpm generate-mqtt-graphql-queries
