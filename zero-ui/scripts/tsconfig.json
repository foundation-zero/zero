{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"],
      "@common/*": ["../src/modules/common/*"]
    }
  },
  "include": ["*.ts"]
}
