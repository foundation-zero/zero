{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["mqtt", "modbus", "hullTemperature"],
  "properties": {
    "mqtt": {
      "type": "object",
      "required": ["host", "port", "existingSecret"],
      "properties": {
        "host": {
          "type": "string",
          "description": "MQTT broker hostname."
        },
        "port": {
          "type": "integer",
          "description": "MQTT broker port.",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "description": "MQTT username."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Kubernetes Secret containing the MQTT password."
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "description": "Key in the existing Secret that holds the MQTT password."
        }
      }
    },
    "modbus": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "description": "Modbus server hostname."
        },
        "port": {
          "type": "integer",
          "description": "Modbus TCP port.",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "stub": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy an in-cluster stub Modbus server and point the bridge at it."
        },
        "temperature": {
          "type": "number",
          "description": "Temperature the stub serves once activated."
        },
        "seconds": {
          "type": "integer",
          "description": "Seconds to run the stub before exiting; -1 runs forever."
        }
      }
    },
    "hullTemperature": {
      "type": "object",
      "required": ["activateTopic", "activateJsonPath"],
      "properties": {
        "activateTopic": {
          "type": "string",
          "description": "MQTT topic used to toggle the relay/multiplexer before reading."
        },
        "activateJsonPath": {
          "type": "string",
          "description": "JSONPath where the boolean activation value is written in the payload."
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository."
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy.",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string",
          "description": "Overrides the image tag whose default is the chart appVersion."
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Container resource requests and limits."
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Secrets for pulling images from a private registry.",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name."
    }
  }
}
