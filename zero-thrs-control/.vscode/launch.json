{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": [
        "debug-test"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
    },
    {
      "name": "THRS: Debug simulation thrusters",
      "type": "debugpy",
      "request": "launch",
      "module": "thrs.cli",
      "args": [
        "run",
        "thrusters"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "LOG_LEVEL": "DEBUG"
      }
    },
    {
      "name": "THRS: Debug simulation dhw",
      "type": "debugpy",
      "request": "launch",
      "module": "thrs.cli",
      "args": [
        "run",
        "dhw"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "LOG_LEVEL": "DEBUG"
      }
    },
    {
      "name": "THRS: Debug graphql api",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": [
        "dev",
        "src/thrs/graphql/asgi.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
    }
  ],
}