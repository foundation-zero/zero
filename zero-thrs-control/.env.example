# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# THRS
MQTT_DEVICES_TOPIC_PREFIX=simulation
MQTT_CONTROLLER_TOPIC_PREFIX=thrs/controller
MQTT_SIMULATOR_TOPIC_PREFIX=thrs/simulator
MQTT_CONTROL_TOPIC_SUFFIX=Command
MQTT_CONTROLLER_TOPIC_SUFFIX=set
MQTT_SIMULATOR_TOPIC_SUFFIX=set

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgrespassword
PG_DB=zero

# Disable state logging and config persistence.
MACHINE_STATE_LOGGING=false
MODULE_PERSISTENCE=false
ALLOW_BOOT_WITHOUT_PERSISTENCE_HAVING_ACTIVE_POSTGRES=false # When postgres is unreachable, refuse to boot if persistence is used.
