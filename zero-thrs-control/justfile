set dotenv-load := true
set dotenv-required := true

default: run

run_api:
    poetry run fastapi dev src/thrs/graphql/asgi.py

run_control module='thrusters':
    poetry run python -m thrs.cli run {{ module }}

[parallel]
run module='thrusters': run_api (run_control module)

check: lint type_check test

lint:
    poetry run ruff check src tests

type_check:
    poetry run pyright

test *args:
    poetry run pytest -m "not io" {{ args }}

test_io *args:
    poetry run pytest -m "io" {{ args }}

format:
    poetry run ruff format --check src tests

compile_fmu file:
    CFLAGS="-std=gnu17 -include unistd.h" poetry run fmpy compile {{ file }}

compile_fmus:
    just compile_fmu src/thrs/simulation/models/XRGTestModel/FMUInterfaceTester_MECS_regular.fmu
    just compile_fmu src/thrs/simulation/models/Adsorption_Module.fmu
    just compile_fmu src/thrs/simulation/models/Consumer_ModuleV9.fmu
    just compile_fmu src/thrs/simulation/models/DC_Module.fmu
    just compile_fmu src/thrs/simulation/models/DHW_Module.fmu
    just compile_fmu src/thrs/simulation/models/Drives_Module.fmu
    just compile_fmu src/thrs/simulation/models/HT_SystemV14.fmu
    just compile_fmu src/thrs/simulation/models/PCM_ModuleV8.fmu
    just compile_fmu src/thrs/simulation/models/PVT_ModuleV16.fmu
    just compile_fmu src/thrs/simulation/models/Thruster_Module_V19.fmu
