{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "Values",
    "required": [
        "mqtt",
        "api",
        "control",
        "postgresql"
    ],
    "properties": {
        "mqtt": {
            "type": "object",
            "required": [
                "host",
                "port",
                "username",
                "existingSecret",
                "devicesTopicPrefix",
                "controllerTopicPrefix",
                "simulatorTopicPrefix",
                "controlTopicSuffix",
                "controllerTopicSuffix",
                "simulatorTopicSuffix"
            ],
            "properties": {
                "host": {
                    "type": [
                        "string"
                    ],
                    "description": "MQTT broker host"
                },
                "port": {
                    "type": "integer",
                    "default": 1883,
                    "description": "MQTT broker port"
                },
                "username": {
                    "type": "string",
                    "description": "MQTT username"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of existing secret containing MQTT password"
                },
                "devicesTopicPrefix": {
                    "type": "string",
                    "description": "MQTT topic prefix for devices"
                },
                "controllerTopicPrefix": {
                    "type": "string",
                    "description": "MQTT topic prefix for controllers"
                },
                "simulatorTopicPrefix": {
                    "type": "string",
                    "description": "MQTT topic prefix for simulators"
                },
                "controlTopicSuffix": {
                    "type": "string",
                    "description": "MQTT topic suffix for control"
                },
                "controllerTopicSuffix": {
                    "type": "string",
                    "description": "MQTT topic suffix for controller"
                },
                "simulatorTopicSuffix": {
                    "type": "string",
                    "description": "MQTT topic suffix for simulator"
                }
            }
        },
        "postgresql": {
            "type": "object",
            "required": [
                "host",
                "db",
                "existingSecret"
            ],
            "properties": {
                "host": {
                    "type": "string",
                    "description": "PostgreSQL database host"
                },
                "db": {
                    "type": "string",
                    "description": "PostgreSQL database name"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of existing secret containing PostgreSQL password"
                }
            }
        },
        "api": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                }
            }
        },
        "control": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false
                },
                "types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}