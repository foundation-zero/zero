{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["mqtt"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository."
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy.",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string",
          "description": "Overrides the image tag whose default is the chart appVersion."
        }
      }
    },
    "specDir": {
      "type": "string",
      "description": "Path to the directory containing AsyncAPI JSON spec files."
    },
    "logLevel": {
      "type": "string",
      "description": "Value for the RUST_LOG environment variable (for example: info, debug, trace).",
      "default": "info"
    },
    "listenPort": {
      "type": "integer",
      "description": "Port the GraphQL HTTP server listens on.",
      "minimum": 1,
      "maximum": 65535
    },
    "command": {
      "type": "string",
      "description": "Subcommand to run: serve (default), validate, listen or print-schema.",
      "enum": ["serve", "validate", "listen", "print-schema"]
    },
    "defaultTtlSecs": {
      "type": "integer",
      "description": "Default TTL in seconds for cached values before they expire.",
      "minimum": 1
    },
    "mqtt": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "description": "MQTT broker hostname."
        },
        "port": {
          "type": "integer",
          "description": "MQTT broker port.",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "description": "MQTT broker username."
        },
        "existingSecret": {
          "type": "string",
          "description": "Existing secret name containing MQTT password."
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "description": "Key in existingSecret that stores the MQTT password."
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Container resource requests and limits."
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Secrets for pulling images from a private registry.",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name."
    }
  }
}
