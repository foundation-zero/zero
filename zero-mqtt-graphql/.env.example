# Copy to .env: `cp .env.example .env`. The values below run against the
# broker from `docker compose --profile data up -d vernemq`.

# MQTT broker. Also fills the broker address in the THRS AsyncAPI spec.
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave unset for an anonymous broker (an empty value is sent as an empty user).
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Port of the GraphQL API
LISTEN_PORT=5103

# Drop schema-invalid payloads instead of caching them (matches thrs-api)
STRICT_VALIDATION=true
# Serve each sensor field on its own (nullable) instead of all-or-nothing
ENABLE_OPTIONAL_SENSOR_VALUES=false
# Serve the THRS parameter mutations and publish their changes to MQTT
ENABLE_MUTATIONS=true

# Topic settings of the THRS spec. Same values as the THRS services use.
MQTT_DEVICES_TOPIC_PREFIX=devices_topic
MQTT_CONTROLLER_TOPIC_PREFIX=controller_topic
MQTT_SIMULATOR_TOPIC_PREFIX=simulation_topic
MQTT_CONTROL_TOPIC_SUFFIX=Command
MQTT_CONTROLLER_TOPIC_SUFFIX=set
MQTT_SIMULATOR_TOPIC_SUFFIX=set
