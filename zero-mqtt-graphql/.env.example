# Copy to .env: `cp .env.example .env`. The values below run against the
# broker from `docker compose --profile data up -d vernemq`.

# MQTT broker. Also fills the broker address in the THRS AsyncAPI spec.
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave unset for an anonymous broker (an empty value is sent as an empty user).
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Port of the GraphQL API
LISTEN_PORT=5103

# Serve Mutations, which publish to Receive Topics. Off by default: the bridge
# has no authorization and these inputs actuate equipment.
# ENABLE_MUTATIONS=false
# How long a Mutation waits for its State topic to show the input.
# MUTATION_TIMEOUT_SECS=10

RUST_LOG=info
