FROM --platform=$BUILDPLATFORM rust:1.99-trixie@sha256:53766005847cbe02c3f59bfa49c1c4bb16695f2c9e5829c3d576a15406f5e733 AS builder

WORKDIR /app

ARG TARGETARCH

RUN apt-get update && \
  if [ "$TARGETARCH" = "arm64" ]; then \
  apt-get install -y gcc-aarch64-linux-gnu && \
  rustup target add aarch64-unknown-linux-gnu; \
  elif [ "$TARGETARCH" = "amd64" ]; then \
  apt-get install -y gcc-x86-64-linux-gnu && \
  rustup target add x86_64-unknown-linux-gnu; \
  fi

ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
ENV CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc
ENV CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++

RUN case "$TARGETARCH" in \
  arm64) echo aarch64-unknown-linux-gnu ;; \
  amd64) echo x86_64-unknown-linux-gnu ;; \
  esac > /rust-target

# Build dependencies against stub sources first, so this layer stays cached
# until Cargo.toml or Cargo.lock change.
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && \
  echo 'fn main() {}' > src/main.rs && \
  touch src/lib.rs && \
  cargo build --release --locked --target "$(cat /rust-target)" && \
  rm -rf src

COPY src ./src

# COPY keeps the checkout mtimes, which are older than the stub build, so touch
# the sources to make cargo rebuild the crate itself.
RUN touch src/*.rs && \
  cargo build --release --locked --target "$(cat /rust-target)" && \
  cp "target/$(cat /rust-target)/release/zero-mqtt-graphql" /app/zero-mqtt-graphql

FROM debian:trixie-slim@sha256:89c1ea91e897f0fe0a3731595330bc45b8bdef4047464a07116f891a94054b31 AS runtime

RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates && \
  rm -rf /var/lib/apt/lists/* && \
  groupadd -g 1001 app && \
  useradd -r -u 1001 -g app app

WORKDIR /app

COPY --from=builder /app/zero-mqtt-graphql /usr/local/bin/zero-mqtt-graphql

# AsyncAPI specs + topic-metadata files, generated by
# scripts/aggregate-specs.sh and placed into the build context by CI
# before building (ci_mqtt_graphql.yaml).
COPY --chown=1001:1001 specs/ /app/specs/

USER 1001

ENTRYPOINT ["zero-mqtt-graphql"]
CMD ["serve", "--spec-dir", "/app/specs"]
