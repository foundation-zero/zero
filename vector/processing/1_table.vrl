.table = .topic

for_each(grouped_topics) -> |_index, grouped_topic| {
  if starts_with(string!(.topic), grouped_topic) {
    .table = replace(grouped_topic, r'/$', "")

    # Split the topic using the grouped_topic as the separator
    parts = split(string!(.topic), grouped_topic)

    # parts[0] will be empty since the topic starts with the group.
    # parts[1] holds the immediate remainder.
    if length(parts) > 1 && parts[1] != "" {
      .group = parts[1]
    }
  }
}

.table = replace(replace!(.table, "/", "__"), "-", "_")
.table = replace(.table, " ", "_")
.table = replace(.table, r'_{3,}', "__")
