{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Iceburger chart values",
  "type": "object",
  "properties": {
    "rabbitmq": {
      "type": "object",
      "description": "RabbitMQ connection configuration",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "username",
        "existingSecret",
        "existingSecretPasswordKey"
      ]
    },
    "iceberg": {
      "type": "object",
      "description": "Iceberg catalog configuration",
      "properties": {
        "catalogType": {
          "type": "string",
          "enum": ["sql", "rest"]
        },
        "catalogUri": {
          "type": "string"
        },
        "warehouse": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": ["catalogType", "catalogUri", "warehouse", "namespace"]
    },
    "s3": {
      "type": "object",
      "description": "S3 configuration",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "accessKeyId": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretAccessKeyKey": {
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "region",
        "accessKeyId",
        "existingSecret",
        "existingSecretAccessKeyIdKey",
        "existingSecretAccessKeyKey"
      ]
    }
  },
  "required": ["rabbitmq", "iceberg", "s3"]
}
