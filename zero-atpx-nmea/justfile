set dotenv-load := true

default: check

check: lint type_check test

check_static: lint_no_fix format type_check

lint:
    uv run ruff check

lint_no_fix:
    uv run ruff check --no-fix src tests

type_check:
    uv run pyright

test *args:
    uv run pytest --cov --cov-report=term-missing:skip-covered {{ args }}

format:
    uv run ruff format --check src tests

generate-asyncapi file="../specs/atpx-nmea.json":
    uv run python -m zero_atpx_nmea generate-asyncapi {{ file }}

regenerate-spec:
    uv run python -m zero_atpx_nmea generate-asyncapi ./asyncapi.json

# Generate AsyncAPI HTML docs from the committed spec (output is gitignored).
# Requires the AsyncAPI CLI on PATH: npm install -g @asyncapi/cli@6.0.2 (as CI does).

# html-template pinned to 3.5.6 to match CI.
docs:
    SUPPRESS_NO_CONFIG_WARNING=true asyncapi generate fromTemplate asyncapi.json @asyncapi/html-template@3.5.6 -o docs/ --force-write
