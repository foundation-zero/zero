set dotenv-load := true

default: check

check: lint type_check test

lint:
    uv run ruff check zero_alert_forwarder tests

lint_no_fix:
    uv run ruff check --no-fix zero_alert_forwarder tests

type_check:
    uv run pyright

test *args:
    uv run pytest --cov --cov-report=term-missing:skip-covered {{ args }}
